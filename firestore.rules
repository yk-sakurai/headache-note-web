rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stripeCustomerId']));
      allow delete: if false;
      
      match /devices/{deviceId} {
        allow read, write: if isOwner(uid);
      }
    }
    
    match /subscriptions/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    
    match /invoices/{uid}/user_invoices/{invoiceId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    
    match /checkout_sessions/{sessionId} {
      allow read: if false;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
    
    match /audit_logs/{logId} {
      allow read, write: if false;
    }
    
    match /debug/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    match /terms/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /privacy_policies/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /{collection}/{document=**} {
      allow read, write: if isAuthenticated() && 
        !(collection in ['users', 'subscriptions', 'invoices', 'checkout_sessions', 'audit_logs', 'terms', 'privacy_policies', 'debug']);
    }
  }
}
